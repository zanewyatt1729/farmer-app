#:import BoxLayout kivy.uix.boxlayout.BoxLayout
#:import Label kivy.uix.label.Label
#:import TextInput kivy.uix.textinput.TextInput
#:import Button kivy.uix.button.Button
#:import ScrollView kivy.uix.scrollview.ScrollView

<LoginScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 10
        spacing: 10

        Label:
            text: 'Login'
            font_size: 32

        TextInput:
            id: username
            hint_text: 'Username'
            multiline: False

        TextInput:
            id: password
            hint_text: 'Password'
            multiline: False
            password: True

        Label:
            id: error_label
            text: ''
            color: (1, 0, 0, 1)

        Button:
            text: 'Login'
            on_press: root.login()

        Button:
            text: 'Register'
            on_press: app.root.current = 'register'

<RegisterScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 10
        spacing: 10

        Label:
            text: 'Register'
            font_size: 32

        TextInput:
            id: username
            hint_text: 'Username'
            multiline: False

        TextInput:
            id: password
            hint_text: 'Password'
            multiline: False
            password: True

        TextInput:
            id: role
            hint_text: 'Role (farmer, consumer, retailer)'
            multiline: False

        Label:
            id: error_label
            text: ''
            color: (1, 0, 0, 1)

        Button:
            text: 'Register'
            on_press: root.register()

        Button:
            text: 'Back to Login'
            on_press: app.root.current = 'login'

<MainScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 10
        spacing: 10

        ScrollView:
            GridLayout:
                id: product_list
                cols: 1
                size_hint_y: None
                height: self.minimum_height

<ProductItem>:
    size_hint_y: None
    height: 100
    orientation: 'vertical'
    padding: 5
    spacing: 5

    Label:
        id: name
        text: ''
        font_size: 20
        bold: True

    Label:
        id: description
        text: ''
        font_size: 14

    Label:
        id: price
        text: ''
        font_size: 16
        color: (0, 0.5, 0, 1)

<ChatScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 10
        spacing: 10

        ScrollView:
            GridLayout:
                id: chat_list
                cols: 1
                size_hint_y: None
                height: self.minimum_height

        TextInput:
            id: message_input
            size_hint_y: None
            height: 40
            multiline: False

        Button:
            text: 'Send'
            size_hint_y: None
            height: 40
            on_press: root.send_message()

<OrderScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 10
        spacing: 10

        ScrollView:
            GridLayout:
                id: order_list
                cols: 1
                size_hint_y: None
                height: self.minimum_height

<ProductItem>:
    size_hint_y: None
    height: 100
    orientation: 'vertical'
    padding: 5
    spacing: 5

    Label:
        id: product_id
        text: ''
        font_size: 16

    Label:
        id: quantity
        text: ''
        font_size: 16

    Label:
        id: status
        text: ''
        font_size: 16
